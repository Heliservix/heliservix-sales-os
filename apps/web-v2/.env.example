NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Needed to create técnico logins from the Personal module ("Crear acceso al
# sistema"). Get it from Supabase → Project Settings → API → "service_role
# secret" key. NEVER prefix this with NEXT_PUBLIC_ — it must stay server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Used only inside the "your account was created" email, to build the login
# link. Defaults to https://app.heliservix.com if left blank.
NEXT_PUBLIC_SITE_URL=https://app.heliservix.com

# Comma-separated list of emails treated as full administrators (see
# anyone else who should see the whole system, not just Portal Técnico).
ADMIN_EMAILS=adolfospinali@gmail.com

# Email notifications when a técnico uploads a weekly report — from
# resend.com (free tier). Leave blank and the app still works, it just
# won't send the email yet.
RESEND_API_KEY=
NOTIFY_EMAIL=adolfospinali@gmail.com
NOTIFY_FROM_EMAIL=HeliServiX OS <onboarding@resend.dev>
